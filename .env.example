# ===========================================
# Signal — production-ready env. Insert API keys and deploy.
# ===========================================

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (payments + Connect)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=false

# OpenAI (avatar generation)
OPENAI_API_KEY=sk-...
# Portrait refine (Avatar) defaults to OpenAI when both keys are set. Force one:
# PREFERRED_AVATAR_ENHANCE_PROVIDER=openai
# PREFERRED_AVATAR_ENHANCE_PROVIDER=gemini
# Frontend can force provider sent to API:
# VITE_AVATAR_ENHANCE_PROVIDER=openai

GEMINI_API_KEY=
# Catalog images: OpenAI if OPENAI_API_KEY is set (default when both Gemini + OpenAI exist). Prefer Gemini:
# PREFERRED_CATALOG_IMAGE_PROVIDER=gemini
# Catalog prompt refinement (LLM expands “Generate” descriptions + “Clean & standardize” notes): uses OPENAI chat when set, else Gemini text + GEMINI_API_KEY
# CATALOG_LLM_MODEL=gpt-4o-mini
# Optional text model for /api/artist-bio and catalog LLM fallback. Default: gemini-2.0-flash
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# Optional: defaults to gemini-2.5-flash-image. Alternatives: gemini-3.1-flash-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# For Gemini 3 image models only: GEMINI_IMAGE_SIZE=1K
PERPLEXITY_API_KEY=

# ElevenLabs (avatar voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Catalogue sync (per-service; or store in integrations)
BANDCAMP_CLIENT_ID=
BANDCAMP_CLIENT_SECRET=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
SHOPIFY_STORE=your-store
SHOPIFY_ACCESS_TOKEN=

# Automation (n8n / Make)
N8N_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# Use `npm run dev:all` (or `npm run dev` + `npm run dev:vercel`); Vite proxies /api here if Vercel dev port differs.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# App URLs (redirects, webhooks)
APP_URL=https://yoursite.com
VITE_APP_URL=https://yoursite.com

# Cron (optional; for POST /api/payouts-run)
CRON_SECRET=

# Optional: Become-artist name suggestion + live “Avatar” host toggle (portrait AI + web bio work without this)
# VITE_ENABLE_AI_FEATURES=true

# RTMP (live stream server)
# RTMP_PORT=1935
# RTMP_HTTP_PORT=8000
# RTMP_MEDIA_ROOT=./server/media
# RTMP_FFMPEG_PATH=ffmpeg
# Local dev (optional; defaults to http://127.0.0.1:8000 in Vite dev): VITE_HLS_BASE_URL=http://127.0.0.1:8000
# Production: VITE_HLS_BASE_URL=https://stream.yoursite.com
# Shown in Dashboard → Go live (local ingest):
# VITE_RTMP_URL=rtmp://127.0.0.1:1935/live
# Production:
# VITE_RTMP_URL=rtmp://your-server/live
